# Copy to .env only if defaults need changing. Do not put API keys here.
RAG_HOST=127.0.0.1
RAG_PORT=8000
RAG_DATA_DIR=data
RAG_PROMPTS_DIR=prompts
RAG_FRONTEND_DIST=frontend/dist
RAG_DEV_ORIGIN=http://127.0.0.1:5173
RAG_MAX_UPLOAD_BYTES=52428800
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=80
RAG_OCR_ENABLED=false
RAG_OCR_LANGUAGES=eng+fra+fas
RAG_RETRIEVAL_CANDIDATES=20
RAG_RETRIEVAL_SNIPPETS=6
RAG_RETRIEVAL_TOKENS=4000
RAG_SUMMARY_TOKENS=700
RAG_CONTEXT_TOKENS=16000
RAG_OUTPUT_TOKENS=2000
RAG_MAX_TOOL_ROUNDS=2
RAG_REQUEST_TIMEOUT_SECONDS=90
RAG_MAX_CONCURRENT_REQUESTS=4
RAG_DEBUG_CHUNKS=false
